# Exception: nlp-macro-event-bot cron persists dedup state across runs by
# committing these back to the repo (see .github/workflows/nlp-macro-event-bot.yml)
!nlp-macro-event-bot/macro_bot_state.json
!nlp-macro-event-bot/news_nlp.db

# alpha_ml runtime artifacts — regenerated by alpha_ml/train.py (models,
# cached OHLCV, backtest status); not source, not meant to be committed.
alpha_ml/models/
alpha_ml/data/*.csv

# Exception: training runs on GitHub Actions, so the status snapshot has to be
# committed back or the local bot's /alpha_status would never see the result.
# Both are small text files (KB), unlike models/ and the cached OHLCV.
!alpha_ml/alpha_status.json
!alpha_ml/alpha_status_history.csv

